# ----------------------------------------------------------------------------
# InventoryFlow — Frontend (Next.js) environment
# Copy to `.env.local` and fill in. See backend/.env.example for the API side.
# ----------------------------------------------------------------------------

# Base URL of the Express API, including the /api/v1 prefix. Used by the browser
# fetch client, which appends paths straight onto it.
#
# Must be ABSOLUTE and must not be blank. NEXT_PUBLIC_* values are inlined at
# build time, so a variable that exists but is empty compiles to '' — every
# request then resolves against the web app's own origin and comes back as the
# Next.js 404 page instead of JSON. Changing this needs a rebuild, not a restart.
#
# Production example: https://inventoryflow-api-exrk.onrender.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Shown in the UI footer / about panel.
NEXT_PUBLIC_APP_NAME=InventoryFlow
